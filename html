:10px;flex-wrap:wrap;margin:20px 0}button{border:1px solid var(--orange);border-radius:3px;background:var(--orange);color:#fff;padding:9px 14px;font:inherit;font-weight:650;cursor:pointer}button.secondary{background:#fff;color:#9b4717}.footer-note{font-size:11px;color:#777;border-top:1px solid #ddd;padding-top:14px;margin-top:24px}@media(max-width:720px){.shell{grid-template-columns:1fr}aside{display:none}main{padding:0 13px}.command{gap:12px}.titlebar{margin:0 -13px;padding:20px}.grid{grid-template-columns:1fr}.qhead{flex-direction:column}.options{justify-content:flex-start}.content{padding-top:18px}.titlebar h1{font-size:24px}}
